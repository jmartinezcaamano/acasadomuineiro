---
import "@styles/global.css";
import { locales, type Locale } from "@data/content";

type Props = {
  title: string;
  description: string;
  lang: Locale;
  ogImage?: string;
};

const { title, description, lang, ogImage = "/images/hero/hero.jpg" } = Astro.props;
const canonicalPath = lang === "es" ? "/" : `/${lang}/`;
const canonical = new URL(canonicalPath, Astro.site ?? "https://acasadomuineiro.com").toString();
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(ogImage, Astro.site ?? "https://acasadomuineiro.com").toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : lang === "gl" ? "gl_ES" : lang === "fr" ? "fr_FR" : "en_GB"} />
    {locales.map((locale) => <link rel="alternate" hreflang={locale.code} href={new URL(locale.href, Astro.site ?? "https://acasadomuineiro.com").toString()} />)}
    <link rel="alternate" hreflang="x-default" href={new URL("/", Astro.site ?? "https://acasadomuineiro.com").toString()} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <slot />
  </body>
</html>
