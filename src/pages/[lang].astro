---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Hero from "@components/Hero.astro";
import IntroCasa from "@components/IntroCasa.astro";
import EditorialBlock from "@components/EditorialBlock.astro";
import RiverBlock from "@components/RiverBlock.astro";
import SpaceSection from "@components/SpaceSection.astro";
import Gallery from "@components/Gallery.astro";
import Amenities from "@components/Amenities.astro";
import Availability from "@components/Availability.astro";
import BookingForm from "@components/BookingForm.astro";
import Nearby from "@components/Nearby.astro";
import Footer from "@components/Footer.astro";
import { content, type Locale } from "@data/content";

export function getStaticPaths() {
  return ["gl", "en", "fr"].map((lang) => ({ params: { lang } }));
}

const lang = Astro.params.lang as Locale;
const t = content[lang];
const title = "A Casa do Muiñeiro · Casa rural completa en la Costa da Morte";
const description = "Casa rural de uso turístico de alquiler íntegro en O Allo, Baio, Costa da Morte. Finca privada, piscina, lareira y acceso al Río Grande.";
---

<BaseLayout title={title} description={description} lang={lang}>
  <Header lang={lang} nav={t.nav} />
  <main>
    <Hero hero={t.hero} />
    <IntroCasa kicker={t.labels.wholeRental} intro={t.intro} />
    <EditorialBlock kicker={t.labels.insideOutside} editorial={t.editorial} />
    <RiverBlock river={t.river} />
    <SpaceSection
      kicker={t.labels.estateHouse}
      title={lang === "gl" ? "Espazos para estar xuntos, dentro e fóra." : lang === "en" ? "Spaces to be together, inside and outside." : "Des espaces pour être ensemble, dedans et dehors."}
      text={lang === "gl" ? "A casa vívese como unha vivenda privada: interiores cálidos, exteriores amplos, piscina, barbacoa e zonas de descanso repartidas pola finca." : lang === "en" ? "The house is lived as a private home: warm interiors, generous exteriors, pool, barbecue and resting areas across the estate." : "La maison se vit comme une demeure privée: intérieurs chaleureux, grands extérieurs, piscine, barbecue et espaces de repos répartis dans le domaine."}
      images={[
        { src: "/images/optimized/exterior-08.jpg", alt: "Exterior de piedra de A Casa do Muiñeiro" },
        { src: "/images/optimized/piscina-01.jpg", alt: "Piscina exterior en la finca privada" },
        { src: "/images/optimized/barbacoa-01.jpg", alt: "Barbacoa exterior para comer fuera" },
        { src: "/images/optimized/chill-out-01.jpg", alt: "Zona chill out exterior" },
      ]}
    />
    <Gallery kicker={t.labels.fullGallery} categoryLabels={t.categories} gallery={t.gallery} />
    <Amenities kicker={t.labels.amenities} amenitiesText={t.amenities} />
    <Availability
      title={lang === "gl" ? "Consulta as datas ocupadas." : lang === "en" ? "Check occupied dates." : "Consultez les dates occupées."}
      text={lang === "gl" ? "O calendario mostra as datas que xa non están dispoñibles. Para confirmar dispoñibilidade real ou consultar estancias especiais, escríbenos." : lang === "en" ? "The calendar shows dates that are no longer available. To confirm real availability or ask about special stays, send us a request." : "Le calendrier affiche les dates déjà indisponibles. Pour confirmer la disponibilité réelle ou demander un séjour spécial, contactez-nous."}
    />
    <BookingForm kicker={t.labels.booking} booking={t.booking} />
    <Nearby kicker={t.labels.nearby} nearby={t.nearby} />
  </main>
  <Footer footer={t.footer} />
</BaseLayout>
