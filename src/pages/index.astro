---
import BaseLayout from "@layouts/BaseLayout.astro";
import Header from "@components/Header.astro";
import Hero from "@components/Hero.astro";
import IntroCasa from "@components/IntroCasa.astro";
import EditorialBlock from "@components/EditorialBlock.astro";
import RiverBlock from "@components/RiverBlock.astro";
import SpaceSection from "@components/SpaceSection.astro";
import Gallery from "@components/Gallery.astro";
import Amenities from "@components/Amenities.astro";
import Availability from "@components/Availability.astro";
import BookingForm from "@components/BookingForm.astro";
import Nearby from "@components/Nearby.astro";
import Footer from "@components/Footer.astro";
import { content } from "@data/content";

const t = content.es;
const title = "A Casa do Muiñeiro · Casa rural completa en la Costa da Morte";
const description = "Casa rural de uso turístico de alquiler íntegro en O Allo, Baio, Costa da Morte. Finca privada, piscina, lareira y acceso al Río Grande.";
---

<BaseLayout title={title} description={description} lang="es">
  <Header lang="es" nav={t.nav} />
  <main>
    <Hero hero={t.hero} />
    <IntroCasa kicker={t.labels.wholeRental} intro={t.intro} />
    <EditorialBlock kicker={t.labels.insideOutside} editorial={t.editorial} />
    <RiverBlock river={t.river} />
    <SpaceSection
      kicker={t.labels.estateHouse}
      title="Espacios para estar juntos, dentro y fuera."
      text="La casa se vive como una vivienda privada: interiores cálidos, exteriores amplios, piscina, barbacoa y zonas de descanso repartidas por la finca."
      images={[
        { src: "/images/optimized/exterior-08.jpg", alt: "Exterior de piedra de A Casa do Muiñeiro" },
        { src: "/images/optimized/piscina-01.jpg", alt: "Piscina exterior en la finca privada" },
        { src: "/images/optimized/barbacoa-01.jpg", alt: "Barbacoa exterior para comer fuera" },
        { src: "/images/optimized/chill-out-01.jpg", alt: "Zona chill out exterior" },
      ]}
    />
    <Gallery kicker={t.labels.fullGallery} categoryLabels={t.categories} gallery={t.gallery} />
    <Amenities kicker={t.labels.amenities} amenitiesText={t.amenities} />
    <Availability />
    <BookingForm kicker={t.labels.booking} booking={t.booking} />
    <Nearby kicker={t.labels.nearby} nearby={t.nearby} />
  </main>
  <Footer footer={t.footer} />
</BaseLayout>
