---
import { categoryOrder, photos, photosByCategory } from "@data/photos";

type Props = {
  kicker: string;
  categoryLabels: Record<string, string>;
  gallery: {
    title: string;
    text: string;
    all: string;
    open: string;
    close: string;
    next: string;
    previous: string;
  };
};

const { kicker, categoryLabels, gallery } = Astro.props;
const json = JSON.stringify(photos);
const labelsJson = JSON.stringify(categoryLabels);
const slug = (value: string) =>
  value
    .normalize("NFD")
    .replace(/[\u0300-\u036f]/g, "")
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
---

<section class="section gallery-section" id="galeria" aria-labelledby="gallery-title">
  <div class="gallery-section__intro">
    <p class="section__kicker">{kicker}</p>
    <h2 id="gallery-title">{gallery.title}</h2>
    <p>{gallery.text}</p>
  </div>

  <div class="gallery-tabs" role="list" aria-label="Categorías de galería">
    <button class="gallery-tabs__button is-active" type="button" data-filter="all">{gallery.all}</button>
    {categoryOrder.map((category) => (
      <button class="gallery-tabs__button" type="button" data-filter={category}>
        {categoryLabels[category] ?? category}
      </button>
    ))}
  </div>

  <div class="gallery-groups">
    {photosByCategory.map(({ category, photos: categoryPhotos }) => (
      <section class="gallery-group" data-group={category} aria-labelledby={`gallery-${slug(category)}`}>
        <h3 id={`gallery-${slug(category)}`}>{categoryLabels[category] ?? category}</h3>
        <div class="photo-grid">
          {categoryPhotos.map((photo) => (
            <button
              type="button"
              class="photo-card"
              data-gallery-item
              data-category={photo.category}
              data-index={photos.findIndex((candidate) => candidate.src === photo.src)}
              aria-label={`${gallery.open}: ${categoryLabels[photo.category] ?? photo.category}`}
            >
              <img src={photo.src} alt={photo.alt} loading="lazy" decoding="async" />
              <span>{categoryLabels[photo.category] ?? photo.category}</span>
            </button>
          ))}
        </div>
      </section>
    ))}
  </div>

  <div class="lightbox" data-lightbox hidden aria-modal="true" role="dialog" aria-label="Galería de imágenes">
    <button class="lightbox__close" type="button" data-lightbox-close aria-label={gallery.close}>×</button>
    <button class="lightbox__nav lightbox__nav--previous" type="button" data-lightbox-previous aria-label={gallery.previous}>‹</button>
    <figure>
      <img data-lightbox-image src="" alt="" />
      <figcaption data-lightbox-caption></figcaption>
    </figure>
    <button class="lightbox__nav lightbox__nav--next" type="button" data-lightbox-next aria-label={gallery.next}>›</button>
  </div>

  <script type="application/json" id="gallery-data" set:html={json}></script>
  <script type="application/json" id="gallery-labels" set:html={labelsJson}></script>
  <script>
    const dataNode = document.getElementById("gallery-data");
    const labelsNode = document.getElementById("gallery-labels");
    const galleryPhotos = dataNode ? JSON.parse(dataNode.textContent || "[]") : [];
    const galleryLabels = labelsNode ? JSON.parse(labelsNode.textContent || "{}") : {};
    const filterButtons = [...document.querySelectorAll("[data-filter]")];
    const groups = [...document.querySelectorAll("[data-group]")];
    const cards = [...document.querySelectorAll("[data-gallery-item]")];
    const lightbox = document.querySelector("[data-lightbox]");
    const lightboxImage = document.querySelector("[data-lightbox-image]");
    const lightboxCaption = document.querySelector("[data-lightbox-caption]");
    const closeButton = document.querySelector("[data-lightbox-close]");
    const previousButton = document.querySelector("[data-lightbox-previous]");
    const nextButton = document.querySelector("[data-lightbox-next]");
    let currentIndex = 0;

    const setFilter = (filter) => {
      filterButtons.forEach((button) => {
        button.classList.toggle("is-active", button.dataset.filter === filter);
      });
      groups.forEach((group) => {
        group.hidden = filter !== "all" && group.dataset.group !== filter;
      });
    };

    const showImage = (index) => {
      currentIndex = (index + galleryPhotos.length) % galleryPhotos.length;
      const photo = galleryPhotos[currentIndex];
      lightboxImage.src = photo.src;
      lightboxImage.alt = photo.alt;
      lightboxCaption.textContent = galleryLabels[photo.category] || photo.category;
    };

    const openLightbox = (index) => {
      showImage(index);
      lightbox.hidden = false;
      closeButton.focus();
    };

    const closeLightbox = () => {
      lightbox.hidden = true;
      lightboxImage.src = "";
    };

    filterButtons.forEach((button) => {
      button.addEventListener("click", () => setFilter(button.dataset.filter));
    });

    cards.forEach((card) => {
      card.addEventListener("click", () => openLightbox(Number(card.dataset.index)));
    });

    closeButton.addEventListener("click", closeLightbox);
    previousButton.addEventListener("click", () => showImage(currentIndex - 1));
    nextButton.addEventListener("click", () => showImage(currentIndex + 1));
    lightbox.addEventListener("click", (event) => {
      if (event.target === lightbox) closeLightbox();
    });
    document.addEventListener("keydown", (event) => {
      if (lightbox.hidden) return;
      if (event.key === "Escape") closeLightbox();
      if (event.key === "ArrowLeft") showImage(currentIndex - 1);
      if (event.key === "ArrowRight") showImage(currentIndex + 1);
    });
  </script>
</section>
