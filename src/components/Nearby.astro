---
import { nearbyLinks } from "@data/links";

type Props = {
  kicker: string;
  nearby: {
    title: string;
    text: string;
  };
};

const { kicker, nearby } = Astro.props;
---

<section class="section nearby" id="entorno" aria-labelledby="nearby-title">
  <div class="nearby__copy">
    <p class="section__kicker">{kicker}</p>
    <h2 id="nearby-title">{nearby.title}</h2>
    <p>{nearby.text}</p>
  </div>
  <div class="nearby__links">
    {nearbyLinks.map(([label, href]) => (
      <a href={href} target="_blank" rel="noreferrer">{label}</a>
    ))}
  </div>
</section>
