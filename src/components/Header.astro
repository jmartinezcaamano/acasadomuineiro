---
import { locales, type Locale } from "@data/content";

type Props = {
  lang: Locale;
  nav: Record<string, string>;
};

const { lang, nav } = Astro.props;
---

<header class="site-header" aria-label="Cabecera principal">
  <a class="brand" href={lang === "es" ? "/" : `/${lang}/`} aria-label="A Casa do Muiñeiro">
    A Casa do Muiñeiro
  </a>
  <nav class="main-nav" aria-label="Navegación principal">
    <a href="#casa">{nav.house}</a>
    <a href="#rio">{nav.river}</a>
    <a href="#galeria">{nav.gallery}</a>
    <a href="#reservas">{nav.booking}</a>
    <a href="#entorno">{nav.nearby}</a>
  </nav>
  <nav class="language-nav" aria-label="Idioma">
    {locales.map((locale) => (
      <a href={locale.href} aria-current={locale.code === lang ? "page" : undefined}>{locale.label}</a>
    ))}
  </nav>
</header>
