---
type Props = {
  kicker: string;
  title: string;
  text: string;
  images: { src: string; alt: string }[];
};

const { kicker, title, text, images } = Astro.props;
---

<section class="section spaces" aria-labelledby="spaces-title">
  <div class="spaces__copy">
    <p class="section__kicker">{kicker}</p>
    <h2 id="spaces-title">{title}</h2>
    <p>{text}</p>
  </div>
  <div class="spaces__grid">
    {images.map((image) => (
      <img src={image.src} alt={image.alt} loading="lazy" decoding="async" />
    ))}
  </div>
</section>
