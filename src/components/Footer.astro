---
import { contactLinks } from "@data/links";

type Props = {
  footer: {
    text: string;
  };
};

const { footer } = Astro.props;
---

<footer class="site-footer">
  <img src="/images/identidad/refugio-atlantico.svg" alt="Sello Refugio Atlántico de A Casa do Muiñeiro" loading="lazy" decoding="async" />
  <div>
    <p class="brand brand--footer">A Casa do Muiñeiro</p>
    <p>{footer.text}</p>
    <p>
      <a href={`tel:${contactLinks.phone}`}>{contactLinks.phoneLabel}</a>
      <span aria-hidden="true"> · </span>
      <a href={`mailto:${contactLinks.email}`}>{contactLinks.email}</a>
    </p>
  </div>
</footer>
