---
type Props = {
  title?: string;
  text?: string;
};

const {
  title = "Consulta las fechas ocupadas.",
  text = "El calendario muestra las fechas que ya no están disponibles. Para confirmar disponibilidad real o consultar estancias especiales, envíanos una consulta.",
} = Astro.props;
---

<section class="availability" id="disponibilidad" aria-labelledby="availability-title">
  <div class="availability__intro">
    <p class="section__kicker">Disponibilidad</p>
    <h2 id="availability-title">{title}</h2>
    <p>{text}</p>
  </div>

  <div class="availability__panel" data-availability>
    <div class="availability__toolbar">
      <button type="button" class="availability__nav" data-prev aria-label="Mes anterior">‹</button>
      <strong data-current-range>Calendario</strong>
      <button type="button" class="availability__nav" data-next aria-label="Mes siguiente">›</button>
    </div>
    <div class="availability__legend" aria-label="Leyenda">
      <span><i class="is-free"></i> Disponible</span>
      <span><i class="is-occupied"></i> Ocupado</span>
    </div>
    <div class="availability__months" data-months aria-live="polite"></div>
    <p class="availability__status" data-status></p>
  </div>

  <script>
    const root = document.querySelector("[data-availability]");
    const monthsNode = root?.querySelector("[data-months]");
    const statusNode = root?.querySelector("[data-status]");
    const currentRangeNode = root?.querySelector("[data-current-range]");
    const previousButton = root?.querySelector("[data-prev]");
    const nextButton = root?.querySelector("[data-next]");
    const formatter = new Intl.DateTimeFormat("es-ES", { month: "long", year: "numeric" });
    const dayFormatter = new Intl.DateTimeFormat("es-ES", { weekday: "short" });
    let cursor = new Date();
    cursor.setUTCDate(1);
    cursor = new Date(Date.UTC(cursor.getFullYear(), cursor.getMonth(), 1));
    let occupiedRanges = [];

    const iso = (date) => date.toISOString().slice(0, 10);
    const addMonths = (date, months) => new Date(Date.UTC(date.getUTCFullYear(), date.getUTCMonth() + months, 1));
    const addDays = (date, days) => {
      const next = new Date(date);
      next.setUTCDate(next.getUTCDate() + days);
      return next;
    };
    const overlapsOccupied = (date) => {
      const day = iso(date);
      return occupiedRanges.some((range) => day >= range.start && day < range.end);
    };

    const render = () => {
      if (!monthsNode || !currentRangeNode) return;
      monthsNode.innerHTML = "";
      const start = cursor;
      const end = addMonths(cursor, 2);
      currentRangeNode.textContent = `${formatter.format(start)} - ${formatter.format(addMonths(end, -1))}`;

      for (let monthIndex = 0; monthIndex < 2; monthIndex += 1) {
        const monthDate = addMonths(cursor, monthIndex);
        const first = new Date(Date.UTC(monthDate.getUTCFullYear(), monthDate.getUTCMonth(), 1));
        const month = document.createElement("article");
        month.className = "availability-month";
        month.innerHTML = `<h3>${formatter.format(first)}</h3>`;

        const grid = document.createElement("div");
        grid.className = "availability-month__grid";
        for (let weekDay = 1; weekDay <= 7; weekDay += 1) {
          const date = new Date(Date.UTC(2026, 5, weekDay));
          const label = document.createElement("span");
          label.className = "availability-month__weekday";
          label.textContent = dayFormatter.format(date).slice(0, 2);
          grid.append(label);
        }

        const startOffset = (first.getUTCDay() + 6) % 7;
        for (let empty = 0; empty < startOffset; empty += 1) {
          const spacer = document.createElement("span");
          spacer.className = "availability-month__empty";
          grid.append(spacer);
        }

        const nextMonth = addMonths(first, 1);
        for (let date = first; date < nextMonth; date = addDays(date, 1)) {
          const day = document.createElement("span");
          day.className = overlapsOccupied(date) ? "availability-day availability-day--occupied" : "availability-day";
          day.textContent = String(date.getUTCDate());
          day.title = overlapsOccupied(date) ? "Ocupado" : "Disponible";
          grid.append(day);
        }

        month.append(grid);
        monthsNode.append(month);
      }
    };

    const load = async () => {
      if (!statusNode) return;
      const from = iso(cursor);
      const to = iso(addMonths(cursor, 2));
      statusNode.textContent = "Cargando disponibilidad...";
      try {
        const response = await fetch(`/api/availability?from=${from}&to=${to}`);
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || "No se pudo cargar la disponibilidad.");
        occupiedRanges = data.occupied || [];
        statusNode.textContent = occupiedRanges.length
          ? "Fechas ocupadas actualizadas."
          : "No constan fechas ocupadas en este periodo.";
      } catch (error) {
        occupiedRanges = [];
        statusNode.textContent = "Disponibilidad no conectada todavía. Consúltanos por WhatsApp o email.";
      }
      render();
    };

    previousButton?.addEventListener("click", () => {
      cursor = addMonths(cursor, -1);
      load();
    });

    nextButton?.addEventListener("click", () => {
      cursor = addMonths(cursor, 1);
      load();
    });

    render();
    load();
  </script>
</section>
